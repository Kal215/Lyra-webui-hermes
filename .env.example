# ==========================================
# LYRA STACK - ENVIRONMENT CONFIGURATION
# ==========================================

# 9Router Configuration
# Add your LLM Provider API Keys here. 9Router will auto-balance them.
OPENROUTER_API_KEY=your_openrouter_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here

# 9Router Settings
ROUTER_STRATEGY=strict-priority
ROUTER_FAILOVER_RETRIES=3

# Memory Core Configuration (Optional overrides)
# MEMORY_RETRIEVAL_LIMIT=5
